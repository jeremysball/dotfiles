{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": true,
      "args": [
        "--no-sandbox",
        "--disable-dev-shm-usage",
        "--log-level=3",
        "--disable-popup-blocking",
        "--disable-notifications",
        "--disable-extensions",
        "--disable-background-networking",
        "--ignore-certificate-errors"
      ],
      "executablePath": "/usr/bin/chromium"
    }
  }
}
