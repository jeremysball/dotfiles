{
  "$schema": "https://opencode.ai/config.json",
"model": "ollama/deepseek-v4-flash:0731",
  "agent": {
    "build": {
      "model": "ollama/deepseek-v4-flash:0731",
      "variant": "max"
    },
    "plan": {
      "model": "ollama/deepseek-v4-flash:0731",
      "variant": "max"
    },
    "summarizer": {
      "description": "Summarization agent running on cheapestinference/kimi-k2.6.",
      "mode": "primary",
      "model": "cheapestinference/kimi-k2.6"
    },
    "title": { "disable": true }
  },
  "provider": {
    "meta": {
      "npm": "@ai-sdk/openai",
      "name": "Meta",
      "options": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{env:META_MODEL_API_KEY}"
      },
      "models": {
        "muse-spark-1.1": {
          "name": "Muse Spark 1.1",
          "reasoning": true,
          "limit": { "context": 1048576, "output": 131072 },
          "modalities": {
            "input": ["text", "image", "pdf", "video"],
            "output": ["text"]
          },
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        }
      }
    },
    "cheapestinference": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CheapestInference",
      "options": {
        "baseURL": "https://api.cheapestinference.com/v1",
        "apiKey": "{env:CHEAPESTINFERENCE_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2",
          "reasoning": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 202752, "output": 131072 },
          "variants": {
            "high": { "reasoningEffort": "high" },
            "max":  { "reasoningEffort": "max" }
          }
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6",
          "reasoning": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 262144, "output": 65536 }
        },
        "kimi-k2.7": {
          "name": "Kimi K2.7",
          "reasoning": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 262144, "output": 262144 }
        }
      }
    }
  },
  "mcp": {
    "kagi": {
      "type": "local",
      "command": ["uvx", "kagimcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--config", "{env:HOME}/.config/playwright-mcp/config.json"],
      "enabled": true
    },
    "taskferry": {
      "type": "local",
      "command": ["taskferry"],
      "enabled": false
    }
  }
}
