{
  "$schema": "https://opencode.ai/config.json",
  "model": "llmgateway/mimo-v2.6-pro",
  "agent": {
    "build": {
      "model": "llmgateway/mimo-v2.6-pro"
    },
    "plan": {
      "model": "llmgateway/mimo-v2.6-pro"
    },
    "summarizer": {
      "description": "Summarization agent running on cheapestinference/kimi-k2.6.",
      "mode": "primary",
      "model": "cheapestinference/kimi-k2.6"
    },
    "free": {
      "description": "Free-tier fallback on OpenCode Zen (opencode/muse-spark-1.3-contributor-free). Use when opencode-go is saturated or when explicitly asked for free.",
      "mode": "primary",
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "title": {
      "disable": true
    }
  },
  "provider": {
    "meta": {
      "npm": "@ai-sdk/openai",
      "name": "Meta",
      "options": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{env:META_MODEL_API_KEY}"
      },
      "models": {
        "muse-spark-1.1": {
          "name": "Muse Spark 1.1",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf",
              "video"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ]
          }
        }
      }
    },
    "cheapestinference": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CheapestInference",
      "options": {
        "baseURL": "https://api.cheapestinference.com/v1",
        "apiKey": "{env:CHEAPESTINFERENCE_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2",
          "reasoning": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 200000,
            "output": 131072
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6",
          "reasoning": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "kimi-k2.7": {
          "name": "Kimi K2.7",
          "reasoning": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 200000,
            "output": 262144
          }
