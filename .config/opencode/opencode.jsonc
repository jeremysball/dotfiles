    "xiaomi-token-plan": {
      // Xiaomi MiMo "Token Plan" coding subscription — native Anthropic-format
      // API. The endpoint ends in `/anthropic` (no `/v1`); `/v1` is appended
      // here in baseURL because @ai-sdk/anthropic only adds `/messages` to
      // whatever baseURL it's given, not `/v1/messages`. The host is not a
      // secret, so it is inline here rather than read from an env var,
      // matching the alibaba-token-plan and nanogpt blocks.
      //   base: https://token-plan-sgp.xiaomimimo.com/anthropic/v1
      //   auth: {env:XIAOMI_TOKEN_PLAN_SGP_API_KEY}
      // Verified live 2026-07-22 via curl: both mimo-v2.5 and mimo-v2.5-pro
      // respond with real `thinking` content blocks. Context/output limits
      // per OpenRouter's listing for the same models (1.05M ctx / 131072 out
      // for both — MiMo-V2.5 is 310B-A15B MoE, MiMo-V2.5-Pro is 1.02T-A42B).
      //
      // NOTE: id deliberately NOT "xiaomi" — opencode already ships a
      // built-in `xiaomi` provider (from models.dev; that's where the
      // unrequested `mimo-v2.5-pro-ultraspeed` model came from when this was
      // first tried under the "xiaomi" id). Reusing that id let the built-in
      // definition's baseURL win the merge over ours and every call 404'd,
      // even though the same request worked fine via raw curl. A distinct id
      // avoids the collision entirely.
      "npm": "@ai-sdk/anthropic",
      "name": "Xiaomi MiMo (Token Plan)",
      "options": {
        "baseURL": "https://token-plan-sgp.xiaomimimo.com/anthropic/v1",
        "apiKey": "{env:XIAOMI_TOKEN_PLAN_SGP_API_KEY}"
      },
      "models": {
        "mimo-v2.5": {
          "name": "MiMo V2.5",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        },
        "mimo-v2.5-pro": {
          "name": "MiMo V2.5 Pro",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        }
      }
    },

    // Built-in providers below (openai, openrouter) are already fully
    // defined by opencode via models.dev — these blocks are partial
    // overrides layered on top (per the "model overrides" note in the
    // provider schema), not full custom provider definitions, so no
    // npm/name/options here. Only `limit.context` is overridden (to 200000,
    // matching the global compaction cap above); `output` is preserved at
    // each model's real native value from models.dev so max-output behavior
    // is unaffected. 2026-08-03: added to close the gap where these
    // providers had no context cap at all and never triggered early
    // compaction. Model list mirrors ~/.pi/agent/settings.json's
    // `providers.*.modelOverrides` (pi's equivalent fleet cap) — keep the
    // two in sync when the actively-dispatched fleet changes.
    // The minimax and opencode-go blocks below are commented out; their
    // shapes survive for a future re-enable.
    // "minimax": {
    //   "models": {
    //     "MiniMax-M2.7": { "limit": { "context": 200000, "output": 131072 } },
    //     "MiniMax-M2.7-highspeed": { "limit": { "context": 200000, "output": 131072 } },
    //     "MiniMax-M3": { "limit": { "context": 200000, "output": 128000 } }
    //   }
    // },
    // "opencode-go": {
    //   // Parity with pi --list-models opencode-go (2026-08-22): pi lists 16
    //   // models. Keep in sync with pi's catalog.
    //   "models": {
    //     "deepseek-v4-flash": { "limit": { "context": 200000, "output": 384000 } },
    //     "glm-5.1": { "limit": { "context": 200000, "output": 32768 } },
    //     "glm-5.2": { "limit": { "context": 200000, "output": 131072 } },
    //     "grok-4.5": { "limit": { "context": 200000, "output": 500000 } },
    //     "hy3": { "limit": { "context": 200000, "output": 64000 } },
    //     "kimi-k2.6": { "limit": { "context": 200000, "output": 65536 } },
    //     "kimi-k2.7-code": { "limit": { "context": 200000, "output": 262144 } },
    //     "kimi-k3": { "limit": { "context": 200000, "output": 131072 } },
    //     "mimo-v2.5": { "limit": { "context": 200000, "output": 128000 } },
    //     "mimo-v2.5-pro": { "limit": { "context": 200000, "output": 128000 } },
    //     "minimax-m2.7": { "limit": { "context": 200000, "output": 131072 } },
    //     "minimax-m3": { "limit": { "context": 200000, "output": 131072 } },
    //     "qwen3.6-plus": { "limit": { "context": 200000, "output": 65536 } },
    //     "qwen3.7-max": { "limit": { "context": 200000, "output": 65536 } },
    //     "qwen3.7-plus": { "limit": { "context": 200000, "output": 65536 } }
    //   }
    // },

    "ollama": {
      // Ollama Cloud: OpenAI-compatible endpoint. deepseek-v4-pro was
      // banned 2026-08-21 ("pro is dog") and re-added 2026-08-30 as a
      // one-time override; the ban was lifted 2026-08-31, so pro is back on
      // the table alongside flash. Both are kept in sync with pi.
      // Verified live via GET https://ollama.com/v1/models 2026-08-30:
      // catalog lists the model id as "deepseek-v4-pro:0813" (dated
      // snapshot, same shape as flash's "deepseek-v4-flash:0731"), not a
      // bare "deepseek-v4-pro" alias — that's why opencode_unknownerror
      // fired on every prior dispatch attempt using the bare id.
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{env:OLLAMA_CLOUD_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash:0731": {
          // Plan-included, confirmed live via a real PONG (2026-08-07).
          // Standing default for ollama/* per user directive 2026-08-07.
          // Pi parity: keep in sync with pi's ollama model list.
          // Thinking ON by default; max variant is explicit per
          // 2026-08-09 standing order (harmless even if endpoint ignores it).
          "name": "DeepSeek V4 Flash 0731 (Ollama Cloud)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 },
          "reasoningEffort": "max",
          "variants": {
            "max": { "reasoningEffort": "max" }
          }
        },
        "deepseek-v4-pro:0813": {
          // Re-added 2026-08-30, ban lifted 2026-08-31. Mirrors the flash
          // entry's shape exactly.
          "name": "DeepSeek V4 Pro 0813 (Ollama Cloud)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 },
          "reasoningEffort": "max",
          "variants": {
            "max": { "reasoningEffort": "max" }
          }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-luna": { "limit": { "context": 200000, "output": 128000 } },
        "gpt-5.6-terra": { "limit": { "context": 200000, "output": 128000 } }
      }
    },
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-flash": { "limit": { "context": 200000, "output": 393216 } },
        "deepseek/deepseek-v4-flash-0731": { "limit": { "context": 200000, "output": 384000 } },
        "tencent/hy3": { "limit": { "context": 200000, "output": 128000 } },
        "tencent/hy3-preview": { "limit": { "context": 200000, "output": 262144 } }
      }
    },

    "nanogpt": {
      // NanoGPT — pay-per-request USD aggregator (nano-gpt.com), added
      // 2026-08-30. REQUEST-ONLY per user directive: never a default
      // route, never an ambient fallback. Dispatch here only when the
      // user names it or names a model only this provider carries.
      //
      // Every model below verified live via a real PONG on 2026-08-30
      // (bare HTTP POST {baseURL}/chat/completions, per probing-providers).
      // Metadata (context/output/reasoning/tool_call/pricing) is read from
      // the provider's own catalog at {baseURL}/models?detailed=true, not
      // guessed. Prices in the trailing comments are USD per Mtok in/out
      // as of that date; balance is a finite prepaid credit, so treat
      // every dispatch as spending real money.
      //
      // Context is capped to the 200k fleet cap for compaction parity with
      // the rest of this file; each model's native window is noted where it
      // is larger. Output stays at the native value.
      //
      // Deliberately excluded: `deepclaude` (provider returns "Model is
      // disabled"), and all `TEE/*` privacy-enclave mirrors (not wanted).
      "npm": "@ai-sdk/openai-compatible",
      "name": "NanoGPT",
      "options": {
        "baseURL": "https://nano-gpt.com/api/v1",
        "apiKey": "{env:NANO_GPT_API_KEY}"
      },
      "models": {
        // --- Uncensored / abliterated: the reason this provider exists here.
        // Replaces the self-hosted Colab A100 + Kaggle T4x2 qwen27b rigs,
        // whose cloudflared/ngrok hostnames rotate every kernel run.
        "qwen/qwen3.8-27b-uncensored": {
          "name": "Qwen 3.8 27B Uncensored",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 32768 } // native ctx 262144 — $0.25/$1.50
        },
        "qwen/qwen3.8-27b-obliterated": {
          "name": "Qwen 3.8 27B Obliterated",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 32768 } // native ctx 262144 — $0.25/$1.50
        },
        "qwen/qwen3.6-35b-a3b-uncensored": {
          "name": "Qwen 3.6 35B A3B Uncensored",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 32768 } // native ctx 262144 — $0.15/$0.95
        },
        "z-ai/glm-5.3-flash-uncensored": {
          "name": "GLM 5.3 Flash Uncensored",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 32768 } // native ctx 262144 — $0.35/$1.40
        },
        "gemma-4-26b-a4b-uncensored": {
          "name": "Gemma 4 26B A4B Uncensored",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 32768 } // native ctx 262144 — cheapest uncensored, $0.12/$0.38
        },
        "alibaba/qwen3.8-flash": {
          "name": "Qwen3.8 Flash",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 900000, "output": 131072 } // native ctx 991808, $0.16/$0.47, added 2026-09-03 for review speed
        },

        // --- Models the rest of the fleet cannot reach at all.
        "anthropic/claude-opus-5": {
          // Claude via a third party. Only reach for this when something
          // genuinely needs Claude *outside* the Claude Code session —
          // inside it, the Agent tool already runs Claude at no USD cost.
          "name": "Claude Opus 5 (NanoGPT)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 128000 } // native ctx 1000000 — $5/$25, priciest non-fugu route
        },
        "x-ai/grok-4.20-multi-agent": {
          // Grok's multi-agent variant; 2M native window is the largest
          // in the fleet.
          "name": "Grok 4.20 Multi-Agent",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 } // native ctx 2000000 — $2/$6
        },
        "sakana/fugu-ultra": {
          // Most expensive route on the account by a wide margin. Verify
          // the balance before pointing anything iterative at it.
          "name": "Sakana Fugu Ultra",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 16384 } // native ctx 1000000 — $5.25/$31.50
        },
        "poolside/laguna-s-2.1": {
          // Cheapest route in this provider, $0.10/$0.20, with reasoning and
          // tools. Good default when a nanogpt dispatch is warranted.
          "name": "Poolside Laguna S 2.1",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 } // native ctx 1048576 — $0.10/$0.20
        },
        "nanogpt/coding-router": {
          // NanoGPT's own routing model — picks a backend per request, so
          // cost varies. Exposes low/medium/high/max as separate upstream
          // ids; the bare id defaults to their standard tier.
          "name": "NanoGPT Coding Router",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 128000 } // native ctx 1000000 — $1.10/$2.20
        },

        // --- Newest since 2026-08-31 sync (added 2026-09-04 from
        // {baseURL}/models?detailed=true; REQUEST-ONLY, no PONG per user).
        // Pi full-syncs the same endpoint (now 641 models); synth-2.5-*
        // previews (no reasoning/tools) and TEE/* mirrors stay pi-only per
        // the curated reasoning:true policy and TEE exclusion above.
        "alibaba/qwen3.8-max-0902": {
          // Alibaba's Sep-02 flagship checkpoint; dated snapshot per the
          // pin-exact-versions convention.
          "name": "Qwen3.8 Max 0902",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 } // native ctx 991808, $2/$6
        },
        "anthropic/claude-fable-5.1": {
          // Top-of-market price: confirm with the user before dispatching.
          "name": "Claude Fable 5.1",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 128000 } // native ctx 1000000, $10/$50
        },
        "google/gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 65536 } // native ctx 1048576, $0.75/$3.75
        },
        "ibm-granite/granite-4.2-8b": {
          // Apache 2.0 dense 8B, agentic-trained; endpoint reports no
          // max_output_tokens so output uses the 32768 fallback.
          "name": "Granite 4.2 8B",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 131072, "output": 32768 } // native ctx 131072, $0.10/$0.15
        },
        "inception/mercury-2.5-preview": {
          // Diffusion LM, cheapest frontier route here; good for
          // latency-sensitive coding subagents.
          "name": "Mercury 2.5 Preview",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 65536 } // native ctx 260000, $0.04/$0.15
        },
        "meta/muse-spark-1.3": {
          // Also reachable via the meta provider; nanogpt route is the
          // pay-per-request alternative. Endpoint reports no
          // max_output_tokens so output matches the meta fleet value.
          "name": "Muse Spark 1.3",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 } // native ctx 1048576, $1.25/$4.25
        },
        "meta/muse-spark-1.3-contributor": {
          // Contributor tier, same note as above; cheapest Muse route.
          "name": "Muse Spark 1.3 Contributor",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 } // native ctx 1048576, $0.10/$0.20
        },
        "openai/gpt-6-astra": {
          // Top-of-market price: confirm with the user before dispatching.
          "name": "GPT 6 Astra",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 128000 } // native ctx 1050000, $10/$50
        },
        "openai/gpt-6-astra-pro": {
          // Top-of-market price: confirm with the user before dispatching.
          "name": "GPT 6 Astra Pro",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 128000 } // native ctx 1050000, $10/$50
        },

        // --- Web-grounded research (no tool_call; they search internally).
        "sonar-reasoning-pro": {
          "name": "Perplexity Sonar Reasoning Pro",
          "reasoning": true,
          "tool_call": false,
          "limit": { "context": 127000, "output": 128000 } // $2/$8
        }
      }
    }
  },

  // Skill registry, shared with kilo (same schema key, kilo is a fork).
  // Two entries, and both are stable paths on purpose:
  //   ~/.claude/skills       personal skills, already versionless
  //   ~/.claude/fleet-skills generated symlinks to plugin skills, which
  //                          otherwise live behind a version directory
  //                          (superpowers/6.3.0/skills) that moves on every
  //                          plugin update and silently dangles.
  // This key replaces the old ~/.config/opencode/skills/ symlink farm, which
  // had rotted to 25 dead links out of 29. That directory now holds only
  // hand-written opencode-specific skills; opencode scans it natively.
  // Regenerate with `mise run sync-fleet-skills`; `mise run check-fleet-skills`
  // and the global pre-commit hook report drift.
  "skills": {
    "paths": ["~/.claude/skills", "~/.claude/fleet-skills"]
  },

  "mcp": {
    "kagi": {
      "type": "local",
      "command": ["uvx", "kagimcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless", "--isolated"],
      "enabled": true
    },
    "taskferry": {
      "type": "local",
      "command": ["taskferry"],
      "enabled": false
    }
  }
}
