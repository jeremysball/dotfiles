    "ollama": {
      // Ollama Cloud: OpenAI-compatible endpoint. deepseek-v4-pro was
      // banned 2026-08-21 ("pro is dog") and re-added 2026-08-30 as a
      // one-time override; the ban was lifted 2026-08-31, so pro is back on
      // the table alongside flash. Both are kept in sync with pi.
      // Verified live via GET https://ollama.com/v1/models 2026-08-30:
      // catalog lists the model id as "deepseek-v4-pro:0813" (dated
      // snapshot, same shape as flash's "deepseek-v4-flash:0731"), not a
      // bare "deepseek-v4-pro" alias — that's why opencode_unknownerror
      // fired on every prior dispatch attempt using the bare id.
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{env:OLLAMA_CLOUD_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash:0731": {
          // Plan-included, confirmed live via a real PONG (2026-08-07).
          // Was the standing default for ollama/* per user directive
          // 2026-08-07 until 2026-10-08, when the fleet default moved to
          // llmgateway/mimo-v2.6-pro — this pin was retired upstream
          // 2026-09-25 ("deepseek-v4-flash:0731 was retired at 2026-09-25")
          // and is kept registered only as the fleet's dated snapshot,
          // same as in kilo.jsonc and pi's models.json.
          // Thinking ON by default; max variant is explicit per
          // 2026-08-09 standing order (harmless even if endpoint ignores it).
          "name": "DeepSeek V4 Flash 0731 (Ollama Cloud)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 400000, "output": 131072 },
          "reasoningEffort": "max",
          "variants": {
            "max": { "reasoningEffort": "max" }
          }
        },
        "deepseek-v4-pro:0813": {
          // Re-added 2026-08-30, ban lifted 2026-08-31. Mirrors the flash
          // entry's shape exactly.
          "name": "DeepSeek V4 Pro 0813 (Ollama Cloud)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 350000, "output": 131072 },
          "reasoningEffort": "max",
          "variants": {
            "max": { "reasoningEffort": "max" }
          }
        },
        // Bare alias, registered 2026-10-08 for ollama-set parity with kilo
        // (which gets it from models.dev's ollama-cloud catalog). It is a
        // real id — the API resolves it and answers "This model is not in
        // the Free plan", i.e. paywalled, not retired — and
        // deepseek-v4-pro is a REQUEST-ONLY family that must stay
        // requirable. Limits are models.dev's native values.
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": { "context": 1048576, "output": 1048576 }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-luna": { "limit": { "context": 200000, "output": 128000 } },
        "gpt-5.6-terra": { "limit": { "context": 200000, "output": 128000 } },
        "gpt-6.1-sol": { "limit": { "context": 200000, "output": 128000 } },
        "gpt-6.1-sol-fast": { "limit": { "context": 200000, "output": 128000 } },
        "gpt-6-luna": { "limit": { "context": 200000, "output": 128000 } }
      }
