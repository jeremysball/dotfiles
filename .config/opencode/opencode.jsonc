  // Skill registry, shared with kilo (same schema key, kilo is a fork).
  // Two entries, and both are stable paths on purpose:
  //   ~/.claude/skills       personal skills, already versionless
  //   ~/.claude/fleet-skills generated symlinks to plugin skills, which
  //                          otherwise live behind a version directory
  //                          (superpowers/6.3.0/skills) that moves on every
  //                          plugin update and silently dangles.
  // This key replaces the old ~/.config/opencode/skills/ symlink farm, which
  // had rotted to 25 dead links out of 29. That directory now holds only
  // hand-written opencode-specific skills; opencode scans it natively.
  // Regenerate with `mise run sync-fleet-skills`; `mise run check-fleet-skills`
  // and the global pre-commit hook report drift.
  "skills": {
    "paths": ["~/.claude/skills", "~/.claude/fleet-skills"]
  },

  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.83", "--config", "{env:HOME}/.config/playwright-mcp/config.json"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@1.11.0", "--browserUrl", "http://127.0.0.1:9222", "--no-usage-statistics", "--no-performance-crux", "--redact-network-headers"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "taskferry": {
      "type": "local",
      "command": ["taskferry"],
      "enabled": false
    }
  }
}
