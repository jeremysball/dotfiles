// ~/.config/opencode/opencode.jsonc
//
// OpenCode global config — loaded once on startup, NOT hot-reloaded. Quit
// and restart opencode after any edit.
//
// Sources of truth:
//   - Schema:    https://opencode.ai/config.json
//   - Model DB:  https://github.com/anomalyco/models.dev/tree/dev/providers/<provider>
//   - Provider docs: linked per-provider below
//
// Conventions for this file:
//   - `cheapestinference` is a CUSTOM provider, not in models.dev — its model
//     definitions here are hand-written against the cheapinference API. See
//     `~/.config/opencode/skills/configure-opencode-provider` for the
//     process to add a new model.
//
// Variant naming on the default model:
//   ollama/deepseek-v4-flash:0731 declares a `max` variant (explicit
//   reasoningEffort per 2026-08-09 standing order; harmless even if the
//   endpoint ignores it).
//   glm-5.2 also declares `high`/`max` variants — as of 2026-07-20 these
//   are no-op identifiers (reasoning is force-disabled on the model to
//   sidestep a parser bug), kept so `/model glm-5.2:max` still resolves.
//
// Provider liveness lives in provider-status.yml, one boolean per
// provider. It is the only record of which providers are dispatchable;
// do not restate it here. Some blocks below are commented out so their
// config shape survives a re-enable, which says nothing about whether
// the provider is currently live.

{
  "$schema": "https://opencode.ai/config.json",

  // Compaction: the fleet cap is 200k tokens for dispatch routes. The
  // 2026-10-24 1017 exception and the shared 45k buffer are documented in
  // docs/things-that-look-like-bugs.md.
  // (per the schema, `reserved` is a literal token buffer subtracted from
  // limit.context, NOT a percentage; verified against
  // https://opencode.ai/config.json's Config.compaction.reserved
  // description: "Token buffer for compaction. Leaves enough window to
  // avoid overflow during compaction." 2026-08-03: the prior comment here
  // claiming a percentage-based trigger was wrong, and several
  // actively-dispatched built-in providers (minimax, opencode-go, openai,
  // openrouter) had no limit.context override at all, so they were running
  // at their real 200k-1.05M raw limits, nowhere near triggering compaction
  // early. Explicit 200000-context overrides now cover every actively
  // dispatched model below; add new models here whenever the fleet changes
  // (see using-taskferry's "Always Use A Worktree" and the choosing-a-model
  // skill for what's actively dispatched).
  //   docs: https://opencode.ai/config.json ($defs.Config.properties.compaction)
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2,
    "preserve_recent_tokens": 20000,
    "reserved": 45000
  },

  // Default model: llmgateway/mimo-v2.6-pro. Switched 2026-10-08 (user
  // directive) from ollama/deepseek-v4-flash:0731: that pin was retired
  // upstream 2026-09-25 ("deepseek-v4-flash:0731 was retired at 2026-09-25
  // 00:00:00 -0700 PDT") and every live Ollama Cloud model now answers
  // "This model is not in the Free plan", so the whole route is
  // undispatchable on this account. mimo-v2.6-pro confirmed live via a real
  // PONG on opencode and kilo 2026-10-08. It is the ONE llmgateway/ model
  // exempted from REQUEST-ONLY in verify-provider-parity.sh (the rest of
  // that block stays request-only).
  //   auth: {env:LLM_GATEWAY_API_KEY}
  //   base: the llmgateway provider block below
  "model": "llmgateway/mimo-v2.6-pro",

  // Terminal and shell tool calls run through the mise-activated wrapper
  // instead of a bare bash, so every command resolves the working
  // directory's .mise.toml (tools, versions, [env]) without the
  // `mise exec` workaround. Added 2026-10-18 together with the kilo
  // twin; see .config/mise/agent-shell.sh and the [dotfiles] entry that
  // links it into place. The {env:HOME} form is required here: the shell
  // value is not tilde-expanded, and a spawn failure falls back to a bare
  // bash with no error at all (both verified live 2026-10-18).
  "shell": "{env:HOME}/.config/mise/agent-shell.sh",

  "agent": {
    "build": {
      // Default agent runs llmgateway/mimo-v2.6-pro (thinking on by
      // default). No `variant` here: unlike the retired ollama flash pin,
      // mimo-v2.6-pro declares no variants, so none is requested.
      // Switch per-task:
      //   /agent glm-max                           // glm-5.2 max, reasoning off
      "model": "llmgateway/mimo-v2.6-pro"
    },
    "plan": {
      "model": "llmgateway/mimo-v2.6-pro"
    },
    "glm-max": {
      // Switch into this agent with:  /agent glm-max
      // Pinned to cheapestinference/glm-5.2 with variant `max`. Reasoning is
      // forced off on the model definition (see glm-5.2 entry below) to
      // work around the @ai-sdk/openai-compatible@2.0.41 interleaved-
      // reasoning parser bug — this agent trades the collapsible thinking
      // UI for a clean answer stream. The `max` variant is preserved as a
      // stable identifier so `/model glm-5.2:max` and external scripts keep
      // resolving the same way.
      "description": "GLM 5.2 (max variant) on cheapestinference, reasoning disabled to avoid the interleaved-reasoning parser bug.",
      "mode": "primary",
      "model": "cheapestinference/glm-5.2",
      "variant": "max"
    },
    "summarizer": {
      // Switch into this agent with:  /agent summarizer
      // Model: cheapestinference/kimi-k2.6 (was cheapestinference/minimax-m3
      // until 2026-08-30). Optimized for long-context
      // summarization — quote source when condensing, preserve named entities
      // and numbers exactly, output structured prose (intro / body / closing).
      "description": "Summarization agent running on cheapestinference/kimi-k2.6.",
      "mode": "primary",
      "model": "cheapestinference/kimi-k2.6"
    },
    "free": {
      // Switch into this agent with:  /agent free
      // Free-tier fallback on OpenCode Zen. ~/.local/bin/opencode-auto runs
      // with --agent free when opencode-go is saturated, or on --free.
      // Repointed 2026-10-18 from muse-spark-1.3-contributor-free, which
      // left the live catalog. beam-free is verified live the same day:
      // probe runs drove it directly and `opencode models` lists it.
      "description": "Free-tier fallback on OpenCode Zen (opencode/beam-free). Use when opencode-go is saturated or when explicitly asked for free.",
      "mode": "primary",
      "model": "opencode/beam-free"
    },
    "title": { "disable": true }
  },

  "provider": {
    "meta": {
      // Meta Muse Spark — now via env like all others (was file: ~/.config/opencode/meta-api-key, removed 2026-08-18 per Sir).
      // Parity with pi: keep muse-spark-1.1 / 1.2 / 1.2-contributor /
      // 1.3-contributor in sync with ~/.pi/agent/settings.json
      // meta.modelOverrides and verify-provider-parity.sh.
      "npm": "@ai-sdk/openai",
      "name": "Meta",
      "options": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{env:META_MODEL_API_KEY}"
      },
      "models": {
        "muse-spark-1.1": {
          "name": "Muse Spark 1.1",
          "reasoning": true,
          "limit": { "context": 200000, "output": 131072 },
          "modalities": {
            "input": ["text", "image", "pdf", "video"],
            "output": ["text"]
          },
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "muse-spark-1.2": {
          "name": "Muse Spark 1.2",
          "reasoning": true,
          "limit": { "context": 200000, "output": 131072 },
          "modalities": {
            "input": ["text", "image", "pdf", "video"],
            "output": ["text"]
          },
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "muse-spark-1.2-contributor": {
          "name": "Muse Spark 1.2 Contributor",
          "reasoning": true,
          "limit": { "context": 200000, "output": 131072 },
          "modalities": {
            "input": ["text", "image", "pdf", "video"],
            "output": ["text"]
          },
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "muse-spark-1.3-contributor": {
          // Contributor tier: prompts/outputs may be used to improve Meta's
          // products, in exchange for the cheaper rate. Released 2026-09-02.
          "name": "Muse Spark 1.3 Contributor",
          "reasoning": true,
          "limit": { "context": 200000, "output": 131072 },
          "modalities": {
            "input": ["text", "image", "pdf", "video"],
            "output": ["text"]
          },
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        }
      }
    },

    "cheapestinference": {
      // Custom provider — x402-paywalled API. Models per the cheapinference
      // /v1/models endpoint (frontier pool: minimax-m3, kimi-k2.7, glm-5.2, kimi-k2.6).
      // API docs: https://docs.cheapestinference.com
      // Account: pay USDC subscription at the /v1/models endpoint per-blocks.
      //
      // Switched 2026-07-22 from @ai-sdk/openai-compatible to @ai-sdk/anthropic,
      // pointed at cheapinference's Anthropic-format route. Verified live via
      // curl — same model ids, requests reach the model (rate-limited
      // response, not a routing/auth error). This drops the need for the old
      // openai-compatible reasoning-parser workaround below.
      //
      // NOTE: baseURL must include the trailing `/v1` — @ai-sdk/anthropic
      // appends only `/messages`, not `/v1/messages` (unlike its own default
      // of `https://api.anthropic.com/v1`, which already has the `/v1`
      // baked in). Omitting it 404'd every request even though the same
      // path worked fine via raw curl.
      "npm": "@ai-sdk/anthropic",
      "name": "CheapestInference",
      "options": {
        "baseURL": "https://api.cheapestinference.com/anthropic/v1",
        "apiKey": "{env:CHEAPESTINFERENCE_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          // From models.dev: zai/glm-5.2 — reasoning_effort: high|max (default: max)
          //   https://docs.z.ai/api-reference/llm/chat-completion
          //
          // `reasoning` was restored to true on 2026-07-22 on the theory that
          // the @ai-sdk/anthropic route's native `thinking` content blocks no
          // longer needed the old openai-compatible interleaved-parser
          // workaround. Re-disabled same day (still 2026-07-22): three
          // consecutive taskferry dispatches with reasoning on (two at
          // `--variant max`, one at `--variant high`) all crashed with the
          // identical AI-SDK error `"reasoning part 0 not found"` — a
          // reasoning-delta chunk referencing an id no preceding
          // reasoning-start chunk registered, i.e. malformed/out-of-order
          // SSE framing from cheapestinference's Anthropic-format endpoint
          // itself. Not fixed by removing an unrelated dangling
          // opencode-think-strip plugin symlink that was also suspected.
          // Back to `false` — but note (2026-07-22) this does NOT fix the
          // crash and is not even a display-only mitigation: confirmed with
          // a bare dispatch using NO --variant flag at all (so no
          // reasoningEffort override could be in play), and it still
          // crashed with the identical `"reasoning part 0 not found"`
          // error within ~1s, session non-null. The cheapestinference
          // Anthropic-format endpoint sends thinking content blocks
          // unconditionally on this model, unaffected by this flag.
          // `cheapestinference/glm-5.2` is unusable for ANY taskferry
          // dispatch right now, not just high-effort variants — do not
          // dispatch to it until this is fixed upstream. See
          // working-report.md for the full failure history.
          "name": "GLM 5.2",
          "reasoning": false,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 },
          "variants": {
            "high": { "reasoningEffort": "high" },
            "max":  { "reasoningEffort": "max"  }
          }
        },
        "kimi-k2.6": {
          // From models.dev: moonshotai/kimi-k2.6 — toggle only (no effort).
          "name": "Kimi K2.6",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 65536 }
        },
        "kimi-k2.7": {
          // From models.dev: moonshotai/kimi-k2.7-code — always-on reasoning,
          // no toggle or effort surfaced.
          "name": "Kimi K2.7",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 262144 }
        },
        // Restored 2026-10-08: pi's cheapestinference extension never dropped
        // this model, so the fleets had drifted (parity failure "cheapestinference
        // pi vs opencode (4 vs 3)"). Re-registered here rather than deleted from
        // pi, per the fleet rule that an unregistered model cannot be requested.
        // It was commented out when the summarizer moved to kimi-k2.6 on
        // 2026-08-30; the frontier-pool comment above still lists it, and
        // dispatch stays request-only regardless of registration.
        "minimax-m3": {
          // From models.dev: minimax/MiniMax-M3 — toggle only.
          "name": "MiniMax M3",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        }
      }
    },

    // Block commented out, not deleted, so the config shape survives a
    // re-enable. See provider-status.yml for whether it is dispatchable.
//     "alibaba-tknplan": {
//       // Alibaba Cloud Model Studio "Token Plan" subscription (SG endpoint,
//       // verified live 2026-07-29 via curl → 200 OK on
//       // https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic/v1/messages).
//       // Auth: {env:ALIBABA_TOKEN_PLAN_API_KEY} (the Anthropic-format token-plan
//       // route rejects the bare RAM AccessKey pair with 401 InvalidApiKey).
//       //
//       // baseURL already includes the trailing /v1 because @ai-sdk/anthropic
//       // appends only /messages (unlike its own default of
//       // https://api.anthropic.com/v1, which has the /v1 baked in). Omitting it
//       // 404s every request.
//       //
//       // Only the preview model carries an explicit thinking.budgetTokens; the
//       // rest rely on the provider default per user instruction.
//       "npm": "@ai-sdk/anthropic",
//       "name": "Alibaba Cloud Model Studio (Token Plan, SG)",
//       "options": {
//         "baseURL": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic/v1",
//         "apiKey": "{env:ALIBABA_TOKEN_PLAN_API_KEY}"
//       },
//       "models": {
//         "qwen3.8-max-preview": {
//           "name": "Qwen3.8 Max Preview",
//           "limit": { "context": 200000, "output": 131072 },
//           "options": {
//             "thinking": {
//               "type": "enabled",
//               "budgetTokens": 99072
//             },
//             "temperature": 0.6,
//             "reasoning": true
//           }
//         },
//         "qwen3.7-max": {
//           "name": "Qwen3.7 Max",
//           "limit": { "context": 200000, "output": 131072 },
//           "options": {
//             "thinking": {
//               "type": "enabled"
//             }
//           }
//         },
//         "qwen3.7-plus": {
//           "name": "Qwen3.7 Plus",
//           "limit": { "context": 200000, "output": 131072 },
//           "modalities": {
//             "input": ["text", "image"],
//             "output": ["text"]
//           },
//           "options": {
//             "thinking": {
//               "type": "enabled"
//             }
//           }
//         },
//         "qwen3.6-plus": {
//           "name": "Qwen3.6 Plus",
//           "limit": { "context": 200000, "output": 131072 },
//           "modalities": {
//             "input": ["text", "image"],
//             "output": ["text"]
//           },
//           "options": {
//             "thinking": {
//               "type": "enabled"
//             }
//           }
//         },
//         "qwen3.6-flash": {
//           "name": "Qwen3.6 Flash",
//           "limit": { "context": 200000, "output": 131072 },
//           "modalities": {
//             "input": ["text", "image"],
//             "output": ["text"]
//           },
//           "options": {
//             "thinking": {
//               "type": "enabled"
//             }
//           }
//         },
//         // Roster expanded 2026-08-18 per the official supported-models table
//         // (alibabacloud.com/help/en/model-studio/token-plan-team-overview and
//         // the DeepSeek model page, help.aliyun.com/en/model-studio/deepseek-api
//         // — "models must match character-by-character; any difference in
//         // version or sub-model means the model is not supported"). The
//         // provider's own docs list both a bare alias (`deepseek-v4-pro`,
//         // `deepseek-v4-flash`, which floats to the current default snapshot)
//         // and pinned dated snapshots (`deepseek-v4-pro-0813`,
//         // `deepseek-v4-flash-0731`) as distinct valid IDs. Registered here as
//         // the pinned dated snapshots, per user directive, matching this
//         // repo's general "pin exact versions" convention rather than a
//         // floating alias. This block previously had no DeepSeek entry at
//         // all (bare or dated) — that omission, not the ID's date suffix, is
//         // what crashed every dispatch to `deepseek-v4-pro-0813`/
//         // `deepseek-v4-flash-0731` with `opencode_unknownerror` (reproduced
//         // live 2026-08-18, tasks oc_msz6lgka_8affb193 / oc_msz6lh7m_0fdfb118).
//         // 2026-08-22: deepseek-v4-pro-0813 removed per standing ban
//         // (choosing-a-model 2026-08-21: pro is dog, ollama+alibaba flash-only);
//         // parity with pi's alibaba-tknplan.js which also excludes it.
//         // Ban lifted 2026-08-31 ("pro is back on the table"); re-add if
//         // alibaba's token plan is re-enabled.
