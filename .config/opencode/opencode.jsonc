    "llmgateway": {
      // LLM Gateway (llmgateway.io) — OpenAI-compatible aggregator, added
      // 2026-10-06. Liveness verified via bare HTTP GET {baseURL}/models
      // (HTTP 200) per probing-providers; model metadata below is read from
      // that live catalog, not guessed. Prices in trailing comments are USD
      // per Mtok in/out. Balance is finite, so treat every dispatch as
      // spending real money: REQUEST-ONLY like nanogpt, never a default
      // route or ambient fallback — with one user-directed exception
      // (2026-10-08): mimo-v2.6-pro is the fleet default, see that entry.
