        "kimi-k3": { "name": "Kimi K3", "reasoning": true, "tool_call": true, "limit": { "context": 200000, "output": 16000 } }, // native ctx 1048576, $3.2664/16.332
        "minimax-m2.7": { "name": "MiniMax M2.7", "reasoning": true, "tool_call": true, "limit": { "context": 200000, "output": 6553 } }, // native ctx 262100, $0.484/1.852
        "minimax-m3": { "name": "MiniMax M3", "reasoning": true, "tool_call": true, "limit": { "context": 200000, "output": 512000 } }, // native ctx 512000, $0.32664/1.30656
        "prism": { "name": "Prism", "reasoning": false, "tool_call": true, "limit": { "context": 200000, "output": 16000 } }, // native ctx 1000000, $3.2664/16.332
