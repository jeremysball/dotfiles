      "models": {
        "deepseek/deepseek-v4-flash": { "limit": { "context": 400000, "output": 393216 } },
        "deepseek/deepseek-v4-flash-0731": { "limit": { "context": 400000, "output": 384000 } },
        "tencent/hy3": { "limit": { "context": 200000, "output": 128000 } },
        "tencent/hy3-preview": { "limit": { "context": 200000, "output": 262144 } }
