    "nanogpt": {
      // NanoGPT — pay-per-request USD aggregator (nano-gpt.com), added
      // 2026-08-30. REQUEST-ONLY per user directive: never a default
      // route, never an ambient fallback. Dispatch here only when the
      // user names it or names a model only this provider carries.
      //
      // Every model below verified live via a real PONG on 2026-08-30
      // (bare HTTP POST {baseURL}/chat/completions, per probing-providers).
      // Metadata (context/output/reasoning/tool_call/pricing) is read from
      // the provider's own catalog at {baseURL}/models?detailed=true, not
      // guessed. Prices in the trailing comments are USD per Mtok in/out
      // as of that date; balance is a finite prepaid credit, so treat
      // every dispatch as spending real money.
      //
      // Context is capped to the 200k fleet cap for compaction parity with
      // the rest of this file; each model's native window is noted where it
      // is larger. Output stays at the native value.
      //
      // Deliberately excluded: `deepclaude` (provider returns "Model is
      // disabled"), and all `TEE/*` privacy-enclave mirrors (not wanted).
      "npm": "@ai-sdk/openai-compatible",
      "name": "NanoGPT",
      "options": {
        "baseURL": "https://nano-gpt.com/api/v1",
        "apiKey": "{env:NANO_GPT_API_KEY}"
      },
      "models": {
        // --- Uncensored / abliterated: the reason this provider exists here.
        // Replaces the self-hosted Colab A100 + Kaggle T4x2 qwen27b rigs,
        // whose cloudflared/ngrok hostnames rotate every kernel run.
