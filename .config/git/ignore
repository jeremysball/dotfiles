# OS cruft
.DS_Store
Thumbs.db
Desktop.ini

# Editor swap/backup files
*.swp
*.swo
*.sw?
*~
.idea/

# VS Code: ignore local workspace state, allow shared team config
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Agent-tool state (Claude Code, superpowers, taskferry, playwright-mcp, pi)
**/.claude/settings.local.json
**/.claude/worktrees/
# .superpowers/ is tracked in full — plans, specs, and SDD scratch state are
# part of a repo's record, not agent noise. A repo that genuinely needs one
# path in there untracked re-ignores that exact path in its own .gitignore.
**/.worktrees/
**/.playwright-mcp/
**/.pi/

# Python bytecode caches
__pycache__/
