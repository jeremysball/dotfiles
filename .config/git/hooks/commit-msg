#!/usr/bin/env bash
# ~/.config/git/hooks/commit-msg: global commit-msg hook, deployed by dotfiles.
#
# Wired automatically: [core] hooksPath = ~/.config/git/hooks lives in the
# tracked .gitconfig, and this file ships via the [dotfiles] table, so every
# machine that runs `mise bootstrap dotfiles apply` gets it with zero manual
# setup. Repos with their own core.hooksPath get it through the
# install-githooks shim (commit-msg is in HOOKS), once re-run there.
#
# Two jobs, in order:
#   1. Refuse AI-credit trailers and session links (ACT HUMAN): nothing under
#      the user's name may carry a Claude-Session trailer, a session URL, a
#      Co-Authored-By: Claude trailer, or a Generated-with footer.
#   2. Require a Conventional Commits subject line, except for the subjects
#      git (Merge, Revert, fixup!/squash!/amend!) and pass (inside a password
#      store) generate.
# No bypass, by user directive 2026-10-11: fix the message and commit again.
set -euo pipefail

msg_file="${1:?commit-msg: no message file given}"
subject="$(sed -n '1p' "$msg_file")"

fail() { echo "commit-msg: blocked. $1" >&2; exit 1; }

for banned in "Claude-Session:" "claude.ai/code/session_" "Co-Authored-By: Claude" "Generated with [Claude"; do
  if grep -qF "$banned" "$msg_file"; then
    fail "message contains '$banned'. Strip AI-credit trailers and session links, then commit again."
  fi
done

# Every carve-out below sits after the trailer check, so job 1 still runs on
# the subjects it lets through.

# Merge, revert, and autosquash commits keep git's own generated subjects.
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

# pass(1) writes its own subjects ("Add given password for X to store.") and
# offers no way to change them, the same as git's generated subjects above.
# Let those through, and only in a password store: a repo whose top level
# holds the .gpg-id that `pass init` creates. Patterns are every
# git_commit/git_add_file subject in pass 1.7.4. The ones that interpolate
# only a user path ("Remove X.", "Rename X to Y.", "Copy X to Y.") match any
# subject of that shape; nothing in the text tells them apart from pass's.
# Reencrypt takes .* because deinit leaves the id list empty ("new GPG id .").
repo_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$repo_top" ] && [ -f "$repo_top/.gpg-id" ] \
  && printf '%s' "$subject" | grep -qE \
    '^(Add given password for .+ to store|(Add|Edit) password for .+ using .+|(Add|Replace) generated password for .+|Remove .+|Rename .+ to .+|Copy .+ to .+|Add current contents of password store|Configure git repository for gpg file diff|Set GPG id to .+|Signing new GPG id with .+|Reencrypt password store using new GPG id .*|Deinitialize .*/\.gpg-id( \(.+\))?)\.$'; then
  exit 0
fi

if ! printf '%s' "$subject" | grep -qE '^(feat|fix|chore|docs|refactor|test|style|perf|build|ci)(\(.+\))?(!)?: .+'; then
  fail "subject '$subject' is not Conventional Commits (type(scope): description). Use feat, fix, chore, docs, refactor, test, style, perf, build, or ci."
fi
