#!/usr/bin/env bash
# ~/.config/git/hooks/pre-push: global pre-push, deployed by dotfiles.
#
# Wired automatically: [core] hooksPath = ~/.config/git/hooks lives in the
# tracked .gitconfig, and this file ships via the [dotfiles] table, so every
# machine that runs `mise bootstrap dotfiles apply` gets both with zero
# manual setup. Because it lives in git rather than in an agent harness, it
# fires identically for Claude Code, opencode, kilo, pi, a taskferry worker
# in a bwrap sandbox, and a plain interactive shell.
#
# Two jobs, in order:
#   1. Worktree budget: refuse the push while this repo holds more than the
#      allowed number of *open* worktrees. Enforces CLAUDE.md's "A
#      dangling worktree is illegal". Drain the debt, don't bypass the gate.
#   2. Chain to repo-local .githooks/pre-push / hooks/pre-push if present,
#      so per-repo hooks keep working alongside the global one.
#
# What counts as debt is not decided here. The auditing-worktrees skill
# already owns the classification (merged, clean, in flight, live lock), so
# this hook shells out to its bin/audit-worktrees.sh and counts the worktrees
# it files under safe-to-clean *and* under needs-triage. One source of truth,
# at the cost of the gate going quiet on a machine where the skill isn't
# installed: a missing auditor means the push proceeds, never that it is
# refused.
#
# Both buckets count because both are the same claim. A worktree on disk says
# work is live in that directory, and an unmerged branch parked behind an open
# PR makes that claim just as falsely as a merged one does. Counting only
# safe-to-clean measured the debt already easy to pay and ignored the debt that
# actually accumulates: measured on ~/.claude 2026-09-19, eight worktrees, every
# one of them backed by an open PR, none classified safe-to-clean, cap never
# fired. The auditor hides worktrees active within the last two hours, and that
# is what keeps genuinely live work out of the count.
#
# Cap resolution (flag/env/config triplet, highest precedence first):
#   GIT_MAX_WORKTREES=<n>          env var
#   git config worktree.maxOpen    config key
#   DEFAULT_MAX_WORKTREES          built-in default, below
#
# Auditor resolution, same shape:
#   GIT_WORKTREE_AUDIT_BIN=<path>  env var
#   git config worktree.auditBin   config key
#   DEFAULT_AUDIT_BIN              built-in default, below
#
# Bypass once: git push --no-verify  or  SKIP_WORKTREE_BUDGET=1 git push
set -euo pipefail

DEFAULT_MAX_WORKTREES=3
DEFAULT_AUDIT_BIN="$HOME/.claude/skills/auditing-worktrees/bin/audit-worktrees.sh"

# git exports GIT_DIR (and friends) into a hook, absolute when the push runs
# from a linked worktree. An absolute GIT_DIR outranks `git -C <path>`, so
# every `git -C "$wt"` below would silently answer about the pushing worktree
# instead of $wt. Strip them once, here, rather than prefixing every call.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY

# --- 1. worktree budget ---
check_worktree_budget() {
  [ "${SKIP_WORKTREE_BUDGET:-}" = "1" ] && return 0

  # Not a worktree-capable context (bare repo, submodule push, etc.).
  git rev-parse --show-toplevel >/dev/null 2>&1 || return 0

  local max
  max="${GIT_MAX_WORKTREES:-$(git config --get worktree.maxOpen 2>/dev/null || true)}"
  [ -n "$max" ] || max="$DEFAULT_MAX_WORKTREES"
  case "$max" in
    ''|*[!0-9]*) max="$DEFAULT_MAX_WORKTREES" ;;
  esac

  local here primary
  here="$(git rev-parse --show-toplevel)"
  # The primary checkout is the first entry `git worktree list` prints.
  primary="$(git worktree list --porcelain | awk '/^worktree /{print substr($0,10); exit}')"

  local auditor
  auditor="${GIT_WORKTREE_AUDIT_BIN:-$(git config --get worktree.auditBin 2>/dev/null || true)}"
  [ -n "$auditor" ] || auditor="$DEFAULT_AUDIT_BIN"

  # No auditor, no opinion. The classification lives in auditing-worktrees;
  # without it this hook has no defensible definition of "idle" and
  # guessing one (every registered worktree, say) refuses pushes over work
  # that is genuinely live. Fail open and say why, once.
  if [ ! -f "$auditor" ]; then
    echo "pre-push: worktree budget skipped (no auditor at $auditor)" >&2
    echo "          set worktree.auditBin or GIT_WORKTREE_AUDIT_BIN to enable it" >&2
    return 0
  fi

  # --no-content skips the expensive content-coverage pass; a pre-push hook
  # is not the place to score every unmerged branch against base.
  local report
  report="$(bash "$auditor" --no-content "$primary" 2>/dev/null || true)"

  # audit-worktrees.sh prints prose, bucketed by heading. Take the lines under
  # safe-to-clean and needs-triage, and only those carrying a
  # "(worktree: <path>)" annotation: both buckets also hold branches with no
  # worktree at all, which cost no directory and are not what this cap is
  # about.
  local -a idle=()
  local wt pruned=0
  while IFS= read -r wt; do
    [ -n "$wt" ] || continue
    [ "$wt" = "$primary" ] && continue
    [ "$wt" = "$here" ] && continue
    # git keeps listing a worktree until somebody prunes it, and the auditor
    # reads that same list. A directory already gone from disk is debt that is
    # already paid; counting it refuses the push over nothing and prints it
    # with no branch.
    [ -d "$wt" ] || { pruned=$(( pruned + 1 )); continue; }
    idle+=("$wt")
  done < <(printf '%s\n' "$report" | awk '
    /^  safe-to-clean/       { in_bucket = 1; next }
    /^  needs-triage/        { in_bucket = 1; next }
    /^  [a-z(]/              { in_bucket = 0 }
    in_bucket && /\(worktree: / {
      i = index($0, "(worktree: ")
      rest = substr($0, i + 11)
      j = index(rest, ")")
      if (j > 0) print substr(rest, 1, j - 1)
    }
  ')

  local count=${#idle[@]}
  [ "$count" -le "$max" ] && return 0

  local default_branch
  default_branch="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  [ -n "$default_branch" ] || default_branch="origin/main"

  {
    echo "pre-push: worktree budget exceeded"
    echo ""
    echo "  repo:      $primary"
    echo "  open:      $count worktrees (cap $max): every idle worktree the"
    echo "             auditor sees, merged or not, excluding the primary"
    echo "             checkout, the one you are pushing from, and anything"
    echo "             touched in the last two hours"
    echo ""
    echo "A worktree on disk claims work is live there. A branch parked behind"
    echo "an open PR makes that claim as falsely as a merged one does, and the"
    echo "branch is the work, not the directory: git worktree add rebuilds it in"
    echo "a second if review feedback arrives. Drain these before pushing more:"
    echo ""
    for wt in "${idle[@]}"; do
      local br landed
      br="$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
      landed=""
      # Ask about $wt's own commit, not the branch name: a detached worktree
      # reports the literal string "HEAD", which would resolve against
      # whichever checkout this hook happens to be running in.
      local sha
      sha="$(git -C "$wt" rev-parse HEAD 2>/dev/null || true)"
      if [ -n "$sha" ] && git merge-base --is-ancestor "$sha" "$default_branch" 2>/dev/null; then
        landed="   [already in $default_branch]"
      fi
      printf '  %-58s %s%s\n' "$wt" "$br" "$landed"
    done
    echo ""
    echo "Drain one:"
    echo "  git -C \"$primary\" worktree remove <path>"
    echo "  git -C \"$primary\" worktree prune"
    echo "  git -C \"$primary\" branch -d <branch>   # merged branches only"
    echo ""
    echo "Entries marked [already in $default_branch] are provably finished."
    echo "The rest need their PR merged, closed, or the branch discarded first."
    echo "A squash-merged branch will not show that marker; check"
    echo "'gh-axi pr list --state merged' before assuming it is unfinished."
    echo ""
    echo "Raise the cap deliberately if this repo really runs wide:"
    echo "  git config worktree.maxOpen <n>        # persistent, this repo"
    echo "  GIT_MAX_WORKTREES=<n> git push         # one push"
    echo ""
    echo "Bypass once: git push --no-verify  or  SKIP_WORKTREE_BUDGET=1 git push"
    if [ "$pruned" -gt 0 ]; then
      echo "($pruned registered worktree(s) are already gone from disk;"
      echo " 'git worktree prune' clears the registrations, but they were"
      echo " not counted above.)"
      echo ""
    fi
    echo "Bypassing leaves the debt. Draining is the point."
  } >&2
  return 1
}

# Invoked by a repo-local shim that dispatches to the repo's own hooks itself.
# Do the budget check and get out of the way: leave stdin untouched for the
# shim to hand on, and skip the chaining block below so the repo's hook does
# not run twice.
if [ -n "${GIT_HOOKS_CHAINED:-}" ]; then
  check_worktree_budget || exit 1
  exit 0
fi

# git feeds pre-push the ref updates on stdin. Capture them once so chained
# repo-local hooks still receive them; this hook itself does not use them.
REF_UPDATES="$(cat)"

check_worktree_budget || exit 1

# --- 2. chain to repo-local hooks ---
# Absolute paths and a realpath self-check, matching the pre-commit sibling.
# A repo whose .githooks/pre-push symlinks back to this file would otherwise
# recurse until it hits process limits.
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
self_path="$(realpath "$0" 2>/dev/null || echo "$0")"

for repo_hook in "$repo_root/.githooks/pre-push" "$repo_root/hooks/pre-push"; do
  [ -f "$repo_hook" ] || continue
  hook_real="$(realpath "$repo_hook" 2>/dev/null || echo "")"
  [ -n "$hook_real" ] && [ "$hook_real" != "$self_path" ] || continue
  if [ -x "$repo_hook" ]; then
    printf '%s' "$REF_UPDATES" | GIT_HOOKS_CHAINED=1 "$repo_hook" "$@"
  else
    printf '%s' "$REF_UPDATES" | GIT_HOOKS_CHAINED=1 bash "$repo_hook" "$@"
  fi
done

exit 0
