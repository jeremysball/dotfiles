#!/usr/bin/env bash
# ~/.config/git/hooks/pre-commit: global pre-commit, deployed by dotfiles.
#
# Wired automatically: [core] hooksPath = ~/.config/git/hooks lives in the
# tracked .gitconfig, and this file ships via the [dotfiles] table, so every
# machine that runs `mise bootstrap dotfiles apply` gets both with zero
# manual setup.
#
# Five jobs, in order:
#   1. Dash gate: block staged em/en dashes and double-hyphen stand-ins.
#      Override once: git commit --no-verify  or  SKIP_DASH_CHECK=1 git commit.
#   2. dotfiles adhd-theme guardrail: if the repo has
#      scripts/check-adhd-themes.sh (i.e. this IS the dotfiles repo), run it
#      in --tracked-only mode so kilo/opencode can't commit a theme that
#      silently drops. No-op in every other repo.
#   3. fleet skill-registry guardrail: in dotfiles or dotclaude, run
#      scripts/sync-fleet-skills.sh --tracked-only so a dropped skills.paths
#      entry or an absolute/dangling fleet-skills symlink can't be committed.
#      No-op in every other repo.
#   4. Primary-checkout gate: refuse to commit from a repo's primary
#      checkout. Every change belongs in a linked worktree, so the primary
#      stays a stable merge base for concurrent workers.
#      Override once: git commit --no-verify  or  SKIP_PRIMARY_CHECK=1 git commit.
#      Opt a repo out for good (env/config pair, highest precedence first):
#        GIT_REQUIRE_LINKED_WORKTREE=0    env var
#        git config worktree.requireLinked false   config key
#        DEFAULT_REQUIRE_LINKED           built-in default, below
#   5. Chain to repo-local .githooks/pre-commit / hooks/pre-commit if present,
#      so per-repo hooks keep working alongside the global one.
set -euo pipefail

DEFAULT_REQUIRE_LINKED=true

# --- 1. dash gate ---
# The em dash is only the most obvious form. The same prose shape arrives as an
# en dash, a horizontal bar, or a double hyphen standing in for one, and a model
# that knows the gate exists reaches for those next.
#
# Blocked, because these are prose:
#   two hyphens with whitespace on both sides, the plain em-dash stand-in
#   two hyphens tight between two alphanumerics, the typewriter em dash
#   the em dash, en dash, and horizontal bar characters themselves
#
# Not blocked, because these are real syntax:
#   --flag          a long option
#   word --word     space on the left only, reads as an option
#   word--          nothing on the right, reads as a decrement
#   ---             frontmatter, a markdown rule, a table separator row
#   <!-- -->        an HTML/markdown comment
#
# The whole match runs under LC_ALL=C so it behaves identically on every
# machine: the dash characters are compared as raw bytes, and [[:space:]] and
# [[:alnum:]] stay ASCII-only. Building the dash bytes with printf '\xNN'
# rather than bash's $'\uXXXX' matters for the same reason. Under a C locale
# bash cannot encode the escape and emits its six literal characters instead,
# which would both miss every real dash and block any line containing that
# ASCII text.
if [ "${SKIP_DASH_CHECK:-}" = "1" ] || [ "${SKIP_EMDASH_CHECK:-}" = "1" ] \
  || [ "${SKIP_EMDASH:-}" = "1" ]; then
  :
else
  em_dash="$(printf '\xe2\x80\x94')"     # U+2014 em dash
  en_dash="$(printf '\xe2\x80\x93')"     # U+2013 en dash
  bar_dash="$(printf '\xe2\x80\x95')"    # U+2015 horizontal bar

  # Characters that render as a space but are not one. Folded to a plain space
  # before matching, so padding a double hyphen with them is not an escape.
  nbsp="$(printf '\xc2\xa0')"            # U+00A0 no-break space
  nnbsp="$(printf '\xe2\x80\xaf')"       # U+202F narrow no-break space
  figsp="$(printf '\xe2\x80\x87')"       # U+2007 figure space

  dash_re="$em_dash|$en_dash|$bar_dash|[[:space:]]--[[:space:]]|[[:alnum:]]--[[:alnum:]]"

  # Added lines only. Drop the "+++ b/path" file header, but keep every other
  # line starting with '+' so a markdown "+ " bullet is still inspected.
  added="$(git diff --cached --unified=0 --no-color 2>/dev/null \
    | LC_ALL=C grep -E '^\+' \
    | LC_ALL=C grep -v '^+++ ' \
    | sed -e 's/^+//' -e "s/$nbsp/ /g" -e "s/$nnbsp/ /g" -e "s/$figsp/ /g" || true)"

  # A herestring, not `printf | grep -q`. grep -q exits on the first match,
  # printf then dies of SIGPIPE, and pipefail promotes that 141 to the
  # pipeline's status, which the `if` reads as "no match". The gate silently
  # stopped firing on exactly the diffs most likely to carry a stray dash:
  # measured, a 2.4MB input with an em dash on line 1 reported no match.
  if LC_ALL=C grep -Eq "$dash_re" <<<"$added"; then
    echo "pre-commit: dash blocked. Staged changes contain an em/en dash or a double-hyphen stand-in." >&2
    echo "" >&2
    echo "Fix it, then stage again:" >&2
    # The fold has to lead. The gate normalises no-break spaces to a plain
    # space before matching, so a hint that skips that step leaves an
    # NBSP-padded double hyphen looking repaired and still blocked.
    printf '  LC_ALL=C sed -E "s/%s/ /g; s/%s/ /g; s/%s/ /g; s/ *[%s%s%s] */, /g; s/[[:space:]]--[[:space:]]/, /g; s/([[:alnum:]])--([[:alnum:]])/\\1, \\2/g"\n' \
      "$nbsp" "$nnbsp" "$figsp" "$em_dash" "$en_dash" "$bar_dash" >&2
    echo "" >&2
    LC_ALL=C grep -E "$dash_re" <<<"$added" | head -n 20 | sed 's/^/  /' >&2 || true
    echo "" >&2
    echo "Replace it with a comma, period, or colon. Keep related words together." >&2
    echo "" >&2
    echo "The double-hyphen rules also match some legitimate code: a BEM class" >&2
    echo "name (block--modifier) and a markdown table separator padded with" >&2
    echo "spaces (| -- |) both look like a dash stand-in. Bypass those." >&2
    echo "Bypass once: git commit --no-verify  or  SKIP_DASH_CHECK=1 git commit" >&2
    exit 1
  fi
fi

# --- 2. dotfiles adhd-theme guardrail (repo-dispatched) ---
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
theme_check="$repo_root/scripts/check-adhd-themes.sh"
if [ -f "$theme_check" ]; then
  "$theme_check" --tracked-only
fi

# --- 3. fleet skill-registry guardrail (dotfiles + dotclaude) ---
# Two repos can break the fleet's skill wiring at commit time: dotfiles owns
# the tracked kilo/opencode configs that declare skills.paths, and dotclaude
# owns the generated ~/.claude/fleet-skills/ symlinks. Prefer the committing
# repo's own copy of the script so a dotfiles worktree validates its own
# configs rather than the primary checkout's; fall back to the deployed copy
# when committing in dotclaude, which has no scripts/ of its own.
fleet_check="$repo_root/scripts/sync-fleet-skills.sh"
if [ ! -f "$fleet_check" ] && [ "$repo_root" = "$HOME/.claude" ]; then
    fleet_check="${MISE_DOTFILES_ROOT:-${DOTFILES_ROOT:-$HOME/.dotfiles}}/scripts/sync-fleet-skills.sh"
fi
if [ -f "$fleet_check" ]; then
    bash "$fleet_check" --tracked-only
fi

# --- 4. primary-checkout gate ---
# The primary checkout is the merge base every concurrent worker reads
# against. A commit landed there forces all of them onto a moved base, so
# every change, regardless of size, belongs in a linked worktree. Compares
# `git rev-parse --show-toplevel` against the first `git worktree list`
# entry (the primary). Fail open outside a work tree: an empty lookup is a
# skip, never a block.
#
# Some repos are not worktree-shaped at all: a tool owns the repo and shells
# out to `git commit` in the one checkout it knows about (pass, a generated
# state repo, an upstream vendor tree). There, "use a worktree" is not advice
# anyone can follow, and the alternative is bypassing on every single commit
# until the bypass is reflex and the gate protects nothing. Such a repo
# declares itself exempt once, by name, instead. Deliberately an explicit
# opt-out and not inferred: a repo with no linked worktrees today is the
# normal case the gate exists for, not evidence the gate does not apply.
require_linked="${GIT_REQUIRE_LINKED_WORKTREE:-$(git config --get worktree.requireLinked 2>/dev/null || true)}"
require_linked="${require_linked:-$DEFAULT_REQUIRE_LINKED}"
case "$require_linked" in
  false | 0 | no | off) require_linked=false ;;
  *) require_linked=true ;;
esac

if [ -z "${SKIP_PRIMARY_CHECK:-}" ] && [ "$require_linked" = true ]; then
  commit_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  commit_primary="$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}' || true)"
  if [ -n "$commit_top" ] && [ -n "$commit_primary" ] && [ "$commit_top" = "$commit_primary" ]; then
    echo "pre-commit: blocked. Committing from the primary checkout ($commit_primary)." >&2
    echo "pre-commit: make the change in a linked worktree instead." >&2
    echo "" >&2
    echo "Bypass once:" >&2
    echo "  git commit --no-verify" >&2
    echo "  SKIP_PRIMARY_CHECK=1 git commit" >&2
    echo "" >&2
    echo "Exempt this repo for good, when a tool owns it and commits here by design:" >&2
    echo "  git config worktree.requireLinked false" >&2
    exit 1
  fi
fi

# --- 5. chain to repo-local pre-commit if present ---
# Skipped when a repo shim already invoked us (GIT_HOOKS_CHAINED=1). That
# shim dispatches to .githooks/pre-commit.local itself once we return, so
# chaining here would re-enter the shim and run the gates above twice.
# See scripts/install-githooks.sh.
if [ -n "${GIT_HOOKS_CHAINED:-}" ]; then
  exit 0
fi

local_hook="$repo_root/.githooks/pre-commit"
alt_hook="$repo_root/hooks/pre-commit"

self_path="$(realpath "$0" 2>/dev/null || echo "$0")"
local_real="$(realpath "$local_hook" 2>/dev/null || echo "")"
alt_real="$(realpath "$alt_hook" 2>/dev/null || echo "")"

# GIT_HOOKS_CHAINED goes on every exec here, matching pre-push:198. Without
# it, a repo that carries the tracked shim but whose core.hooksPath still
# points at this directory (a fresh clone on a dotfiles machine that has not
# run install-githooks) gets both gates twice: this hook runs sections 1-3,
# execs .githooks/pre-commit, and the shim, seeing no flag, invokes this
# hook again from the top.
if [ -n "$local_real" ] && [ "$local_real" != "$self_path" ] && [ -x "$local_hook" ]; then
  exec env GIT_HOOKS_CHAINED=1 "$local_hook" "$@"
elif [ -n "$local_real" ] && [ "$local_real" != "$self_path" ] && [ -f "$local_hook" ]; then
  exec env GIT_HOOKS_CHAINED=1 bash "$local_hook" "$@"
elif [ -n "$alt_real" ] && [ "$alt_real" != "$self_path" ] && [ -x "$alt_hook" ]; then
  exec env GIT_HOOKS_CHAINED=1 "$alt_hook" "$@"
elif [ -n "$alt_real" ] && [ "$alt_real" != "$self_path" ] && [ -f "$alt_hook" ]; then
  exec env GIT_HOOKS_CHAINED=1 bash "$alt_hook" "$@"
fi

exit 0