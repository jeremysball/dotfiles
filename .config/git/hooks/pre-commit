#!/usr/bin/env bash
# ~/.config/git/hooks/pre-commit: global pre-commit, deployed by dotfiles.
#
# Wired automatically: [core] hooksPath = ~/.config/git/hooks lives in the
# tracked .gitconfig, and this file ships via the [dotfiles] table, so every
# machine that runs `mise bootstrap dotfiles apply` gets both with zero
# manual setup.
#
# Nine jobs, in order:
#   1. Dash gate: block staged em/en dashes and double-hyphen stand-ins,
#      in prose files and in code comments (dash-gate.py).
#      No bypass, by user directive 2026-10-11: fix the flagged line.
#   2. Hardcoded absolute path gate: block a staged code line that hardcodes
#      /home/..., /workspace/..., a username, or a hostname, per CLAUDE.md's
#      "Avoid hardcoded absolute paths" rule. No bypass, by user directive
#      2026-10-11: make the line relative or resolve it from an env var.
#   3. dotfiles adhd-theme guardrail: if the repo has
#      scripts/check-adhd-themes.sh (i.e. this IS the dotfiles repo), run it
#      in --tracked-only mode so kilo/opencode can't commit a theme that
#      silently drops. No-op in every other repo.
#   4. fleet skill-registry guardrail: in dotfiles or dotclaude, run
#      scripts/sync-fleet-skills.sh --tracked-only so a dropped skills.paths
#      entry or an absolute/dangling fleet-skills symlink can't be committed.
#      No-op in every other repo.
#   5. Primary-checkout gate: refuse to commit from a repo's primary
#      checkout. Every change belongs in a linked worktree, so the primary
#      stays a stable merge base for concurrent workers. The one exemption
#      is the repo-local worktree.requireLinked config key, for repos a tool
#      owns and commits in by design (documented in
#      docs/things-that-look-like-bugs.md). The SKIP_PRIMARY_CHECK and
#      GIT_REQUIRE_LINKED_WORKTREE env knobs were removed 2026-10-11 by user
#      directive, and the blocked message advertises no bypass.
#   6. developing-software index check: when the commit stages a skills/
#      gitlink or .gitmodules, run check-index.py --warn so an unclassified
#      skill cannot stay invisible. Warn only until its false-positive rate
#      is measured; no-op when the skill checkout is absent.
#   7. Repo check task: run the repo's declared `mise run check` task. Its
#      failure blocks the commit, so a repo's own gate is not skipped.
#   8. No-check notice: print "no check task declared" when the repo has no
#      check task, instead of staying silent about having no gate at all.
#   9. Chain to repo-local .githooks/pre-commit / hooks/pre-commit if present,
#      so per-repo hooks keep working alongside the global one.
set -euo pipefail

DEFAULT_REQUIRE_LINKED=true
# --- 1. dash gate ---
# The em dash is only the most obvious form. The same prose shape arrives as an
# en dash, a horizontal bar, or a double hyphen standing in for one. The rules
# and the file handling live in dash-gate.py next to this hook: prose files are
# checked line by line, code files only in their comments (ast-grep decides
# what a comment is), so a shell end-of-options double hyphen is not a dash.
# Resolve through the symlink: [dotfiles] links this hook into
# ~/.config/git/hooks, and dash-gate.py sits beside the real file.
# The SKIP_DASH_CHECK family of env hatches was removed 2026-10-11 by user
# directive ("no more bypassing the gate"), so the gate always runs.
python3 "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/dash-gate.py"

# --- 2. hardcoded absolute path gate ---
# ~/.claude/CLAUDE.md's "Avoid hardcoded absolute paths" rule, mechanised. The
# rule survived in prose for a long time because nothing enforced it; this is
# the check that lets the rule's text eventually be deleted from CLAUDE.md,
# which is what that file's own "Ladder, best first: mechanical check, rule
# here, nothing" asks for.
#
# Scans only staged code files and only the lines this commit adds, so prose
# naming an example path and a pre-existing violation elsewhere both pass.
abs_path_gate="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/abs-path-gate.py"
if [ -x "$abs_path_gate" ]; then
  "$abs_path_gate" || exit 1
fi

# --- 3. dotfiles adhd-theme guardrail (repo-dispatched) ---
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
theme_check="$repo_root/scripts/check-adhd-themes.sh"
if [ -f "$theme_check" ]; then
  "$theme_check" --tracked-only
fi

# --- 4. fleet skill-registry guardrail (dotfiles + dotclaude) ---
# Two repos can break the fleet's skill wiring at commit time: dotfiles owns
# the tracked kilo/opencode configs that declare skills.paths, and dotclaude
# owns the generated ~/.claude/fleet-skills/ symlinks. Prefer the committing
# repo's own copy of the script so a dotfiles worktree validates its own
# configs rather than the primary checkout's; fall back to the deployed copy
# when committing in dotclaude, which has no scripts/ of its own.
fleet_check="$repo_root/scripts/sync-fleet-skills.sh"
if [ ! -f "$fleet_check" ] && [ "$repo_root" = "$HOME/.claude" ]; then
    fleet_check="${MISE_DOTFILES_ROOT:-${DOTFILES_ROOT:-$HOME/.dotfiles}}/scripts/sync-fleet-skills.sh"
fi
if [ -f "$fleet_check" ]; then
    bash "$fleet_check" --tracked-only
fi

# --- 5. primary-checkout gate ---
# The primary checkout is the merge base every concurrent worker reads
# against. A commit landed there forces all of them onto a moved base, so
# every change, regardless of size, belongs in a linked worktree. Compares
# `git rev-parse --show-toplevel` against the first `git worktree list`
# entry (the primary). Fail open outside a work tree: an empty lookup is a
# skip, never a block.
#
# Some repos are not worktree-shaped at all: a tool owns the repo and shells
# out to `git commit` in the one checkout it knows about (pass, a generated
# state repo, an upstream vendor tree). There, "use a worktree" is not advice
# anyone can follow, and the alternative is bypassing on every single commit
# until the bypass is reflex and the gate protects nothing. Such a repo
# declares itself exempt once, by name, instead. Deliberately an explicit
# opt-out and not inferred: a repo with no linked worktrees today is the
# normal case the gate exists for, not evidence the gate does not apply.
# git accepts False, NO, and OFF as readily as false, no, and off, so a
# case-sensitive match would silently ignore a config value git itself
# considers a valid boolean and leave the gate on.
# The config key is the ONLY exemption, read with --local on purpose so one
# stray `git config --global worktree.requireLinked false` cannot disarm the
# gate machine-wide; the exemption is per repo by design. The
# SKIP_PRIMARY_CHECK and GIT_REQUIRE_LINKED_WORKTREE env knobs were removed
# 2026-10-11 by user directive ("no more bypassing the gate"), and the
# blocked message no longer advertises any bypass: three of six unguided
# agents given a routine commit task reached for SKIP_PRIMARY_CHECK because
# the hook's own error printed it.
is_off() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    false | 0 | no | off) return 0 ;;
    *) return 1 ;;
  esac
}

require_linked="$(git config --local --get worktree.requireLinked 2>/dev/null || true)"
commit_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
# substr($0,10) rather than $2, matching pre-push. awk's $2 stops at the
# first space, so a repo under a path containing one yielded a truncated
# path, never matched --show-toplevel, and the gate silently never fired
# there.
commit_primary="$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print substr($0,10); exit}' || true)"
# Not `exit 0` on the exempt path: section 5 still has to chain to the
# repo-local hook, which an early exit here would silently skip.
if [ -n "$commit_top" ] && [ -n "$commit_primary" ] \
  && [ "$commit_top" = "$commit_primary" ] \
  && ! is_off "${require_linked:-$DEFAULT_REQUIRE_LINKED}"; then
  echo "pre-commit: blocked. Committing from the primary checkout ($commit_primary)." >&2
  echo "pre-commit: make the change in a linked worktree instead." >&2
  echo "" >&2
  echo "No bypass for this gate; a linked worktree is the fix." >&2
  echo "Repos a tool owns and commits in by design can declare themselves" >&2
  echo "exempt once; that is documented in docs/things-that-look-like-bugs.md." >&2
  exit 1
fi

# --- 6. developing-software index check (warn only) ---
# Layer 1 of the commit-boundary checks in developing-software's
# 03-checks.md. The skill repo is private and CI cannot see the tree this
# machine actually has, so the global hook is the only caller that can run
# the check unasked. Limit it to commits that change the belief: a staged
# skills/ gitlink or a staged .gitmodules. A machine without dotclaude skips
# the whole section.
index_check="$HOME/.claude/skills/developing-software/bin/check-index.py"
if [ -f "$index_check" ]; then
  if git diff --cached --raw --diff-filter=ACMRTUXB 2>/dev/null \
      | awk '$2 == "160000" && $6 ~ /^skills\// { found=1 } END { exit !found }' \
    || git diff --cached --name-only --diff-filter=ACMRTUXB 2>/dev/null \
      | awk '$0 == ".gitmodules" { found=1 } END { exit !found }'; then
    python3 "$index_check" --warn \
      || echo "pre-commit: check-index could not run" >&2
  fi
fi

# --- 7. repo check task (mise) ---
# Layer 2 of the same ledger: each governed repo declares one check task and
# the hook runs the whole task, not a hand-picked subset. Read mise's own
# task list so a task in mise.toml, .mise.toml, or an included config all
# count, while a task inherited from the global config does not. A failing
# check blocks the commit and names itself through mise's own output.
check_declared=0
if command -v mise >/dev/null 2>&1; then
  if mise -C "$repo_root" tasks --json 2>/dev/null \
      | python3 -c 'import json, sys
tasks = json.load(sys.stdin)
sys.exit(0 if any(t.get("name") == "check" and not t.get("global") for t in tasks) else 1)'; then
    check_declared=1
  fi
fi

if [ "$check_declared" = 1 ]; then
  mise -C "$repo_root" run check || exit 1
else
  # --- 8. no-check notice ---
  echo "pre-commit: no check task declared; this repo has no commit-boundary check (mise run check)." >&2
fi

# --- 9. chain to repo-local pre-commit if present ---
# Skipped when a repo shim already invoked us (GIT_HOOKS_CHAINED=1). That
# shim dispatches to .githooks/pre-commit.local itself once we return, so
# chaining here would re-enter the shim and run the gates above twice.
# See scripts/install-githooks.sh.
if [ -n "${GIT_HOOKS_CHAINED:-}" ]; then
  exit 0
fi

local_hook="$repo_root/.githooks/pre-commit"
alt_hook="$repo_root/hooks/pre-commit"

self_path="$(realpath "$0" 2>/dev/null || echo "$0")"
local_real="$(realpath "$local_hook" 2>/dev/null || echo "")"
alt_real="$(realpath "$alt_hook" 2>/dev/null || echo "")"

# GIT_HOOKS_CHAINED goes on every exec here, matching pre-push:198. Without
# it, a repo that carries the tracked shim but whose core.hooksPath still
# points at this directory (a fresh clone on a dotfiles machine that has not
# run install-githooks) gets both gates twice: this hook runs sections 1-3,
# execs .githooks/pre-commit, and the shim, seeing no flag, invokes this
# hook again from the top.
if [ -n "$local_real" ] && [ "$local_real" != "$self_path" ] && [ -x "$local_hook" ]; then
  exec env GIT_HOOKS_CHAINED=1 "$local_hook" "$@"
elif [ -n "$local_real" ] && [ "$local_real" != "$self_path" ] && [ -f "$local_hook" ]; then
  exec env GIT_HOOKS_CHAINED=1 bash "$local_hook" "$@"
elif [ -n "$alt_real" ] && [ "$alt_real" != "$self_path" ] && [ -x "$alt_hook" ]; then
  exec env GIT_HOOKS_CHAINED=1 "$alt_hook" "$@"
elif [ -n "$alt_real" ] && [ "$alt_real" != "$self_path" ] && [ -f "$alt_hook" ]; then
  exec env GIT_HOOKS_CHAINED=1 bash "$alt_hook" "$@"
fi

exit 0