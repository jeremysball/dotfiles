{
  "$schema": "https://app.kilo.ai/config.json",
  "snapshot": false,
  // Default model: ollama-cloud/deepseek-v4-flash:0731. Replaced
  // alibaba-token-plan/qwen3.8-max-preview on 2026-08-30 when the Alibaba
  // Token Plan lapsed ("Access to model denied" on every dispatch), see
  // the opencode fleet's parallel retirement of alibaba-tknplan the same
  // day (dotfiles d58dbc2). The alibaba-token-plan provider block below is
  // commented out, not deleted, so the config shape survives a re-enable.
  //
  // small_model is the model kilo uses for its own housekeeping calls:
  // title generation, summarization, and compaction. It must be strong
  // enough to summarize a long context without dropping load-bearing
  // detail, because a bad compaction summary is what a resumed session
  // reads instead of the real transcript.
  //
  // It uses the kilo gateway's free tier (kilo has no bare "opencode"
  // provider: `kilo models opencode` returns "Provider not found: opencode";
  // that free zen tier is an opencode-CLI-only thing). kilo's own free
  // models live under its existing "kilo" gateway provider as
  // `kilo/<vendor>/<model>:free`, per `kilo models | rg ':free'`.
  //
  // minimax-m3:free, not nemotron-3.5-lightning:free. The lightning model
  // was picked for raw speed, but compaction is the one housekeeping call
  // where quality matters more than latency: a weak summarizer silently
  // drops detail and the resumed session has no way to know. minimax-m3 is
  // the account's standard-tier workhorse (Reasoning 74.5 vs lightning's
  // tiny fast model) and is still free, so it costs nothing extra and
  // keeps housekeeping off the default model's ollama-cloud quota.
  // Confirmed live: `kilo run --model kilo/minimax/minimax-m3:free` returns
  // a correct summary.
  "model": "ollama-cloud/deepseek-v4-flash:0731",
  "small_model": "kilo/minimax/minimax-m3:free",
  "permission": {
    "*": {
      "*": "allow"
    },
    "bash": "allow",
    "external_directory": {
      "/tmp/*": "allow",
      "/home/jeremy/.config/mise/*": "allow",
      "/home/jeremy/.config/fish/*": "allow",
      "/home/jeremy/.config/fish/functions/*": "allow"
    }
  },
  "compaction": {
    // Auto-compact at 200k, mirroring the opencode fleet compaction
    // (auto:true, reserved 25000) so long contexts compact early.
    "auto": true,
    "prune": true,
    "tail_turns": 2,
    "preserve_recent_tokens": 20000,
    "reserved": 0
  },
  "provider": {
    "openai": {
      // Cap direct OpenAI models at the fleet's 200k context budget. Set
      // input explicitly because compaction uses it when it is present.
      "models": {
        "gpt-5.3-codex-spark": { "limit": { "context": 200000, "output": 32000 } },
        "gpt-5.4": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "gpt-5.4-fast": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "gpt-5.4-mini": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "gpt-5.4-mini-fast": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "gpt-5.5": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "gpt-5.5-fast": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "gpt-5.6-luna": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "gpt-5.6-luna-fast": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "gpt-5.6-sol": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "gpt-5.6-sol-fast": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "gpt-5.6-terra": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "gpt-5.6-terra-fast": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "gpt-6.1-sol": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "gpt-6.1-sol-fast": { "limit": { "context": 200000, "input": 200000, "output": 128000 } }
      }
    },
    "kilo": {
      // OpenAI models via kilo gateway, capped to 200k context to match
      // the fleet cap. Output stays at each model's native value.
      "models": {
        "openai/gpt-4.1": { "limit": { "context": 200000, "input": 200000, "output": 32768 } },
        "openai/gpt-4.1-mini": { "limit": { "context": 200000, "input": 200000, "output": 32768 } },
        "openai/gpt-4.1-nano": { "limit": { "context": 200000, "input": 200000, "output": 32768 } },
        "openai/gpt-5": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5-mini": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5-nano": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5-pro": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.1": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.1-codex": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.1-codex-max": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.1-codex-mini": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.2": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.2-codex": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.2-pro": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.3-codex": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.4": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.4-mini": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.4-nano": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.4-pro": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.5": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.5-pro": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.6-luna": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.6-luna-pro": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.6-sol": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.6-sol-pro": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.6-terra": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-5.6-terra-pro": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
        "openai/gpt-chat-latest": { "limit": { "context": 200000, "input": 200000, "output": 128000 } },
      }
    },
    "ollama-cloud": {
      // Ollama Cloud (turbo) hosted models via its OpenAI-compatible API.
      // {env:...} works fine here (verified with a real run); it's only
      // disallowed in *project*-level kilo.jsonc, not this global one.
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{env:OLLAMA_CLOUD_API_KEY}"
      },
      "models": {
        "glm-5.2": { "name": "GLM 5.2" },
        "nemotron-3-nano:30b": { "name": "Nemotron 3 Nano 30B" },
        "nemotron-3-super": { "name": "Nemotron 3 Super" },
        "nemotron-3-ultra": { "name": "Nemotron 3 Ultra" },
        "kimi-k3": { "name": "Kimi K3" },
        "deepseek-v4-flash:preview": { "name": "DeepSeek V4 Flash (preview)" },
        "gpt-oss:120b": { "name": "GPT-OSS 120B" },
        "gpt-oss:20b": { "name": "GPT-OSS 20B" },
        "deepseek-v4-flash:0731": { "name": "DeepSeek V4 Flash 0731", "limit": { "context": 400000, "output": 131072 } },
        "minimax-m2.7": { "name": "MiniMax M2.7" },
        "gemma4:31b": { "name": "Gemma 4 31B" },
        "qwen3.5:397b": { "name": "Qwen 3.5 397B" },
        "glm-5.1": { "name": "GLM 5.1" },
        "kimi-k2.6": { "name": "Kimi K2.6" },
        "kimi-k2.7-code": { "name": "Kimi K2.7 Code" },
        "deepseek-v4-pro:preview": { "name": "DeepSeek V4 Pro (preview)" },
        "deepseek-v4-pro:0813": { "name": "DeepSeek V4 Pro 0813", "limit": { "context": 350000, "output": 131072 } },
        "minimax-m3": { "name": "MiniMax M3" },
        "mistral-large-3:675b": { "name": "Mistral Large 3 675B" },
      }
    },
    "meta": {
      // Meta Muse Spark, capped to 200k context to match fleet cap (mirrors pi/opencode).
      "models": {
        "muse-spark-1.1": { "limit": { "context": 200000, "output": 200000 } },
        "muse-spark-1.2": { "limit": { "context": 200000, "output": 200000 } },
        "muse-spark-1.2-contributor": { "limit": { "context": 200000, "output": 200000 } },
        "muse-spark-1.3-contributor": { "limit": { "context": 200000, "output": 200000 } }
      }
    },
    // "alibaba-token-plan": {
    //   // Alibaba Cloud Model Studio Token Plan, capped to 200k context.
    //   // DEAD 2026-08-30: token plan lapsed, "Access to model denied" on
    //   // every dispatch. See the opencode fleet's parallel retirement of
    //   // alibaba-tknplan the same day (dotfiles d58dbc2). Current
    //   // liveness: .config/opencode/provider-status.yml.
    //   "models": {
    //     "deepseek-v4-flash": { "limit": { "context": 200000, "output": 384000 } },
    //     "deepseek-v4-flash-0731": { "limit": { "context": 200000, "output": 384000 } },
    //     "deepseek-v4-pro": { "limit": { "context": 200000, "output": 384000 } },
    //     "deepseek-v4-pro-0813": { "limit": { "context": 200000, "output": 384000 } },
    //     "glm-5": { "limit": { "context": 200000, "output": 16384 } },
    //     "glm-5.1": { "limit": { "context": 200000, "output": 128000 } },
    //     "glm-5.2": { "limit": { "context": 200000, "output": 131072 } },
    //     "kimi-k2.5": { "limit": { "context": 200000, "output": 98304 } },
    //     "kimi-k2.6": { "limit": { "context": 200000, "output": 262144 } },
    //     "kimi-k2.7-code": { "limit": { "context": 200000, "output": 262144 } },
    //     "qwen3.6-flash": { "limit": { "context": 200000, "output": 65536 } },
    //     "qwen3.6-plus": { "limit": { "context": 200000, "output": 65536 } },
    //     "qwen3.7-max": { "limit": { "context": 200000, "output": 131072 } },
    //     "qwen3.7-plus": { "limit": { "context": 200000, "output": 65536 } },
    //     "qwen3.8-max": { "limit": { "context": 200000, "output": 131072 } },
    //     "qwen3.8-max-preview": { "limit": { "context": 200000, "output": 131072 } },
    //   }
    // }

    "nanogpt": {
      // NanoGPT — pay-per-request USD aggregator (nano-gpt.com), added
      // 2026-08-30. REQUEST-ONLY per user directive: never a default
      // route, never an ambient fallback. Dispatch here only when the
      // user names it or names a model only this provider carries.
      //
      // Every model below verified live via a real PONG on 2026-08-30
      // (bare HTTP POST {baseURL}/chat/completions, per probing-providers).
      // Metadata (context/output/reasoning/tool_call/pricing) is read from
      // the provider's own catalog at {baseURL}/models?detailed=true, not
      // guessed. Prices in the trailing comments are USD per Mtok in/out
      // as of that date; balance is a finite prepaid credit, so treat
      // every dispatch as spending real money.
      //
      // Context is capped to the 200k fleet cap for compaction parity with
      // the rest of this file; each model's native window is noted where it
      // is larger. Output stays at the native value.
      //
      // Deliberately excluded: `deepclaude` (provider returns "Model is
      // disabled"), and all `TEE/*` privacy-enclave mirrors (not wanted).
      "npm": "@ai-sdk/openai-compatible",
      "name": "NanoGPT",
      "options": {
        "baseURL": "https://nano-gpt.com/api/v1",
        "apiKey": "{env:NANO_GPT_API_KEY}"
      },
      "models": {
        // --- Uncensored / abliterated: the reason this provider exists here.
        // Replaces the self-hosted Colab A100 + Kaggle T4x2 qwen27b rigs,
        // whose cloudflared/ngrok hostnames rotate every kernel run.
        "qwen/qwen3.8-27b-uncensored": {
          "name": "Qwen 3.8 27B Uncensored",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 32768 } // native ctx 262144 — $0.25/$1.50
        },
        "qwen/qwen3.8-27b-obliterated": {
          "name": "Qwen 3.8 27B Obliterated",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 32768 } // native ctx 262144 — $0.25/$1.50
        },
        "qwen/qwen3.6-35b-a3b-uncensored": {
          "name": "Qwen 3.6 35B A3B Uncensored",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 32768 } // native ctx 262144 — $0.15/$0.95
        },
        "z-ai/glm-5.3-flash-uncensored": {
          "name": "GLM 5.3 Flash Uncensored",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 32768 } // native ctx 262144 — $0.35/$1.40
        },
        "gemma-4-26b-a4b-uncensored": {
          "name": "Gemma 4 26B A4B Uncensored",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 32768 } // native ctx 262144 — cheapest uncensored, $0.12/$0.38
        },
        "alibaba/qwen3.8-flash": {
          "name": "Qwen3.8 Flash",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 900000, "output": 131072 } // native ctx 991808, $0.16/$0.47, added 2026-09-03 for review speed
        },

        // --- Models the rest of the fleet cannot reach at all.
        "anthropic/claude-opus-5": {
          // Claude via a third party. Only reach for this when something
          // genuinely needs Claude *outside* the Claude Code session —
          // inside it, the Agent tool already runs Claude at no USD cost.
          "name": "Claude Opus 5 (NanoGPT)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 128000 } // native ctx 1000000 — $5/$25, priciest non-fugu route
        },
        "x-ai/grok-4.20-multi-agent": {
          // Grok's multi-agent variant; 2M native window is the largest
          // in the fleet.
          "name": "Grok 4.20 Multi-Agent",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 } // native ctx 2000000 — $2/$6
        },
        "sakana/fugu-ultra": {
          // Most expensive route on the account by a wide margin. Verify
          // the balance before pointing anything iterative at it.
          "name": "Sakana Fugu Ultra",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 16384 } // native ctx 1000000 — $5.25/$31.50
        },
        "poolside/laguna-s-2.1": {
          // Cheapest route in this provider, $0.10/$0.20, with reasoning and
          // tools. Good default when a nanogpt dispatch is warranted.
          "name": "Poolside Laguna S 2.1",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 } // native ctx 1048576 — $0.10/$0.20
        },
        "nanogpt/coding-router": {
          // NanoGPT's own routing model — picks a backend per request, so
          // cost varies. Exposes low/medium/high/max as separate upstream
          // ids; the bare id defaults to their standard tier.
          "name": "NanoGPT Coding Router",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 128000 } // native ctx 1000000 — $1.10/$2.20
        },

        // --- Newest since 2026-08-31 sync (added 2026-09-04 from
        // {baseURL}/models?detailed=true; REQUEST-ONLY, no PONG per user).
        // Pi full-syncs the same endpoint (now 641 models); synth-2.5-*
        // previews (no reasoning/tools) and TEE/* mirrors stay pi-only per
        // the curated reasoning:true policy and TEE exclusion above.
        "alibaba/qwen3.8-max-0902": {
          // Alibaba's Sep-02 flagship checkpoint; dated snapshot per the
          // pin-exact-versions convention.
          "name": "Qwen3.8 Max 0902",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 } // native ctx 991808, $2/$6
        },
        "anthropic/claude-fable-5.1": {
          // Top-of-market price: confirm with the user before dispatching.
          "name": "Claude Fable 5.1",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 128000 } // native ctx 1000000, $10/$50
        },
        "google/gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 65536 } // native ctx 1048576, $0.75/$3.75
        },
        "ibm-granite/granite-4.2-8b": {
          // Apache 2.0 dense 8B, agentic-trained; endpoint reports no
          // max_output_tokens so output uses the 32768 fallback.
          "name": "Granite 4.2 8B",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 131072, "output": 32768 } // native ctx 131072, $0.10/$0.15
        },
        "inception/mercury-2.5-preview": {
          // Diffusion LM, cheapest frontier route here; good for
          // latency-sensitive coding subagents.
          "name": "Mercury 2.5 Preview",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 65536 } // native ctx 260000, $0.04/$0.15
        },
        "meta/muse-spark-1.3": {
          // Also reachable via the meta provider; nanogpt route is the
          // pay-per-request alternative. Endpoint reports no
          // max_output_tokens so output matches the meta fleet value.
          "name": "Muse Spark 1.3",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 } // native ctx 1048576, $1.25/$4.25
        },
        "meta/muse-spark-1.3-contributor": {
          // Contributor tier, same note as above; cheapest Muse route.
          "name": "Muse Spark 1.3 Contributor",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 } // native ctx 1048576, $0.10/$0.20
        },
        "openai/gpt-6-astra": {
          // Top-of-market price: confirm with the user before dispatching.
          "name": "GPT 6 Astra",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 128000 } // native ctx 1050000, $10/$50
        },
        "openai/gpt-6-astra-pro": {
          // Top-of-market price: confirm with the user before dispatching.
          "name": "GPT 6 Astra Pro",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 128000 } // native ctx 1050000, $10/$50
        },

        // --- Web-grounded research (no tool_call; they search internally).
        "sonar-reasoning-pro": {
          "name": "Perplexity Sonar Reasoning Pro",
          "reasoning": true,
          "tool_call": false,
          "limit": { "context": 127000, "output": 128000 } // $2/$8
        },
      }
    }
  },
  // Skill registry, shared with opencode (same schema key, kilo is a fork).
  // Two entries, and both are stable paths on purpose:
  //   ~/.claude/skills       personal skills, already versionless
  //   ~/.claude/fleet-skills generated symlinks to plugin skills, which
  //                          otherwise live behind a version directory
  //                          (superpowers/6.3.0/skills) that moves on every
  //                          plugin update and silently dangles.
  // Regenerate with `mise run sync-fleet-skills`; `mise run check-fleet-skills`
  // and the global pre-commit hook report drift.
  "skills": {
    "paths": ["~/.claude/skills", "~/.claude/fleet-skills"]
  },
  "instructions": ["~/.claude/CLAUDE_md-addendum-for-non-claude-model.md"]
}
